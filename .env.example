# Скопируй в .env и заполни. Обязателен только BOT_TOKEN.
# Без остальных ключей бот работает, но часть проверок урезана -
# что именно, видно в меню: Ещё -> Статус источников.

# --- Обязательно ---
# @BotFather в Telegram
BOT_TOKEN=

# --- Бесплатно, стоит завести ---

# НЕ НУЖЕН. Выгрузки URLhaus, ThreatFox, Feodo Tracker и SSLBL открыты
# без аутентификации и содержат те же поля, что платный API. Бот работает
# по ним. Поле оставлено на случай исторических запросов вне свежих выгрузок.
# Если всё же заведёшь: auth.abuse.ch, затем проверка tools/check_abusech.py
ABUSECH_API_KEY=

# Репутация IP: жалобы, Tor, тип использования. 1000 проверок в сутки.
# Регистрация: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# Резерв к Blockscout для ETH и 60+ EVM-сетей. Один ключ на все сети.
# 100 000 запросов в сутки. https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Фишинг и вредоносное ПО от Google. Бесплатно.
# Google Cloud Console -> включить Safe Browsing API -> создать ключ
SAFEBROWSING_API_KEY=

# Репутация доменов и IP. https://otx.alienvault.com/
OTX_API_KEY=

# --- Опционально ---

# 70+ антивирусных движков. 500 запросов в сутки, 4 в минуту.
# ВНИМАНИЕ: бесплатный тариф запрещает коммерческое использование.
# https://www.virustotal.com/
VIRUSTOTAL_API_KEY=

# Уточняет оператора телефона сверх офлайн-базы. https://veriphone.io/
VERIPHONE_API_KEY=

# Платный (~4.39 USD в месяц). Не нужен: при пустом значении утечки
# проверяются через бесплатный XposedOrNot. https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- Администрирование ---
# Telegram user id через запятую. Эти пользователи не ограничены rate limit.
ADMIN_IDS=
